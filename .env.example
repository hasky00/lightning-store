# ---------------------------------------------------------------------------
# Merchant wallet (SECRET — never commit a filled-in copy of this file)
# ---------------------------------------------------------------------------
# The NWC connection string the store uses to create invoices and check whether
# they were paid. Create it at https://my.albyhub.com -> Connections ->
# Add Connection, and enable the `make_invoice` and `lookup_invoice`
# permissions. `pay_invoice` is NOT needed and should be left off: the store
# only ever receives.
MERCHANT_NWC_URL=nostr+walletconnect://...

# ---------------------------------------------------------------------------
# Order token signing key
# ---------------------------------------------------------------------------
# Signs the order ids handed to buyers so they cannot be forged or used to look
# up other people's payments. Generate one with:
#   openssl rand -hex 32
ORDER_SIGNING_SECRET=

# ---------------------------------------------------------------------------
# Admin password
# ---------------------------------------------------------------------------
# Guards /admin and every write to the catalogue. Until this is set, the admin
# area is locked rather than open. At least 12 characters.
ADMIN_PASSWORD=
